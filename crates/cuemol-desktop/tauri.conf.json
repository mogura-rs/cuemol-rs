{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cuemol-rs",
  "version": "0.1.0",
  "identifier": "org.cuemol.cuemol2",
  "build": {
    "frontendDist": "tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cuemol-rs",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/app.png"
    ]
  }
}
