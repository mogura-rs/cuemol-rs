{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueMol2",
  "version": "0.1.0",
  "identifier": "org.cuemol.cuemol2",
  "build": {
    "frontendDist": "tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CueMol2",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
